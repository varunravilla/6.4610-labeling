# Copy to .env (never committed) and fill in.

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: force a model instead of auto-picking the newest Flash model
# GEMINI_MODEL=
# Seconds between Gemini calls; raise it if you hit per-minute limits
# GEMINI_PAUSE_SECONDS=7

# Supabase > Connect > "Session pooler" connection string, with your database password filled in
SUPABASE_DB_URL=
