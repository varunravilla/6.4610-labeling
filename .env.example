# Copy this file to .env (already done for you) and replace each value on the right of "=".
# .env is gitignored: it never leaves your laptop.

# 0. Gemini key (free). Get it at https://aistudio.google.com/apikey -> "Create API key".
#    Looks like: AIzaSyA1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q
GEMINI_API_KEY=PASTE_GEMINI_KEY_HERE
# Model with free quota on our key; others: gemini-3.5-flash-lite, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.6-flash

# 1. Supabase database connection (secret: used only by scripts on your laptop).
#    Supabase dashboard -> your project -> "Connect" button (top bar) -> "Session pooler" -> copy the URI,
#    then replace [YOUR-PASSWORD] with the database password you chose when creating the project.
#    Looks like: postgresql://postgres.abcdefghijklmnop:MyDbPassw0rd@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=PASTE_SESSION_POOLER_URI_HERE

# 2. Supabase project URL (public: goes into the website).
#    Supabase dashboard -> Project Settings -> Data API -> "Project URL".
#    Looks like: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=PASTE_PROJECT_URL_HERE

# 3. Supabase anon / publishable key (public: goes into the website).
#    Supabase dashboard -> Project Settings -> API Keys -> the "anon public" key (or "publishable" key).
#    NOT the service_role / secret key.
#    Looks like: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3Mi...   or   sb_publishable_AbC123...
SUPABASE_ANON_KEY=PASTE_ANON_KEY_HERE

# 4. Team passcode you'll send to Wyatt, Matthew, and Kevin. Pick anything.
TEAM_PASSCODE=PICK_A_PASSCODE

# 5. Labelers (space separated). Leave as is unless the team changes.
ANNOTATORS=Wyatt Matthew Varun Kevin
